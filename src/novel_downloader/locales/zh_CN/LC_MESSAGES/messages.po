msgid ""
"Read 'title author' lines from PATH. A single field is the title; use a "
"Tab between title and author when the title contains spaces."
msgstr "从 PATH 读取“书名 作者”行。只有一个字段时视为书名；书名含空格时用 Tab 分隔书名与作者。"

#: src/novel_downloader/apps/cli/commands/batch.py:169
msgid "Continue from a not-found file written by a previous batch run."
msgstr "从上次批量运行写出的未找到文件继续。"

#: src/novel_downloader/apps/cli/commands/batch.py:174
msgid "Search only this site key (default: all sites)."
msgstr "只搜索该站点（默认：全部站点）。"

#: src/novel_downloader/apps/cli/commands/batch.py:180
msgid ""
"Write exported books to DIR and the raw cache to DIR/raw_data (default: "
"from config)."
msgstr "把导出的书写入 DIR，原始缓存写入 DIR/raw_data（默认取自配置）。"

#: src/novel_downloader/apps/cli/commands/batch.py:188
