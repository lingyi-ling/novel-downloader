#: src/novel_downloader/apps/api/main.py:60
#, python-brace-format
msgid ""
"WARNING: no API token configured while binding to {host!r}. Anyone who "
"can reach this port can control downloads and read the exported files "
"under /downloads. Set --token or {env_var}."
msgstr ""
"警告：未配置 API 令牌即绑定到 {host!r}。任何能访问此端口的人都可以控制下载并读取 /downloads 下的导出文件。请设置 "
"--token 或 {env_var}。"

#: src/novel_downloader/apps/api/main.py:69
#, python-brace-format
msgid ""
"WARNING: --cors enables Access-Control-Allow-Origin: * on the non-local "
"bind {host!r}; any website the user visits could then call this API. Use "
"--cors only on 127.0.0.1."
msgstr ""
"警告：--cors 在非本机绑定 {host!r} 上启用 Access-Control-Allow-Origin: "
"*；用户访问的任意网站都将可以调用此 API。--cors 仅应配合 127.0.0.1 使用。"

#: src/novel_downloader/apps/api/main.py:81
msgid "Novel Downloader local REST API."
msgstr "Novel Downloader 本地 REST API。"

#: src/novel_downloader/apps/api/main.py:87
msgid "Address to bind to. Keep 127.0.0.1 unless you configure a token."
msgstr "绑定的监听地址。除非配置了令牌，否则请保持 127.0.0.1。"

#: src/novel_downloader/apps/api/main.py:93
msgid "TCP port to serve the API on."
msgstr "提供 API 服务的 TCP 端口。"

#: src/novel_downloader/apps/api/main.py:99
msgid ""
"Require this token in 'Authorization: Bearer <token>' or 'X-API-Key'. "
"Defaults to NOVEL_API_TOKEN; empty disables auth."
msgstr ""
"要求请求在 'Authorization: Bearer <token>' 或 'X-API-Key' 中携带此令牌。默认读取 "
"NOVEL_API_TOKEN；留空则关闭鉴权。"

#: src/novel_downloader/apps/api/main.py:107
msgid ""
"Enable permissive CORS (Access-Control-Allow-Origin: *). Only for local "
"use; do not combine with a public bind."
msgstr "启用宽松 CORS（Access-Control-Allow-Origin: *）。仅限本机使用；不要与公网绑定同时开启。"

#: src/novel_downloader/apps/api/main.py:116
msgid ""
"Max requests accepted per client IP per sliding window (429 + Retry-After"
" above it). 0 disables rate limiting."
msgstr "每个客户端 IP 在滑动窗口内允许的最大请求数（超出后返回 429 + Retry-After）。0 表示关闭限流。"

#: src/novel_downloader/apps/api/main.py:124
msgid "Length of the --rate-limit sliding window in seconds."
msgstr "--rate-limit 滑动窗口的时长（秒）。"

#: src/novel_downloader/apps/browser/main.py:339
