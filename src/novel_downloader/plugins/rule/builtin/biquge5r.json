{
  "site_key": "biquge5r",
  "site_name": "笔趣阁 (规则源示例)",
  "base_url": "https://www.biquge5.com",
  "encoding": "utf-8",
  "priority": 45,
  "hosts": ["www.biquge5.com"],

  "search": {
    "url": "https://www.biquge5.com/search.php?q={keyword}",
    "method": "GET",
    "item": "div.col-12.col-md-6 dl",
    "priority": 45,
    "fields": {
      "title": {"selector": "dd h3 a", "attr": "text"},
      "url": {"selector": "dt a", "attr": "href"},
      "cover": {"selector": "dt a img", "attr": "src"},
      "author": {"selector": "dd.book_other span", "attr": "text"},
      "latest": {"selector": "dd.book_other a", "attr": "text"},
      "update": {
        "attr": "text",
        "regex": "更新时间：\\s*(.+?)(?=最新章节：|$)",
        "group": 1
      }
    }
  },

  "book": {
    "url": "{base_url}/{book_id}/",
    "pages": {"url": "{base_url}/{book_id}/index_{page}.html", "start": 2},
    "fields": {
      "book_name": {"selector": "meta[property='og:novel:book_name']", "attr": "content"},
      "author": {"selector": "meta[property='og:novel:author']", "attr": "content"},
      "cover_url": {"selector": "meta[property='og:image']", "attr": "content"},
      "update_time": {"selector": "meta[property='og:novel:update_time']", "attr": "content"},
      "serial_status": {"selector": "meta[property='og:novel:status']", "attr": "content"},
      "summary": {"selector": "meta[property='og:description']", "attr": "content"},
      "tags": {
        "selector": "meta[property='og:novel:category']",
        "attr": "content",
        "multi": true
      }
    },
    "chapters": {
      "item": "div.book_list2 a",
      "title": {"attr": "text"},
      "url": {"attr": "href"},
      "id_regex": "/(\\d+)\\.html"
    }
  },

  "chapter": {
    "url": "{base_url}/{book_id}/{chapter_id}.html",
    "pages": {"url": "{base_url}/{book_id}/{chapter_id}_{page}.html", "start": 2},
    "title": {
      "selector": "h1",
      "attr": "text",
      "regex": "^(.+?)\\s*[-—]\\s*《",
      "group": 1
    },
    "content": {"selector": "article", "attr": "inner_text"},
    "replace": [["\u00a0", ""]],
    "drop": ["^第\\(\\d+/\\d+\\)页$"]
  },

  "resolve": {
    "book": "^/([\\d_]+)/?$",
    "chapter": "^/([\\d_]+)/(\\d+)\\.html$"
  }
}
