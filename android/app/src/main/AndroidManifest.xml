<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime permission on Android 13+; used for task completion notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the system installer run the APK downloaded by the in-app updater.
         The user still confirms the install in the system dialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Cleartext stays allowed app-wide because a static network-security
         config cannot enumerate arbitrary LAN addresses: the embedded engine
         listens on http://127.0.0.1 and self-hosted servers are commonly
         reached over plain HTTP on a LAN. The narrower rules live in the
         request path instead (data/NetworkHttp.kt): the API key is only sent
         to the configured origin, an HTTPS server cannot be redirected to
         plain HTTP, and update downloads are separately pinned to HTTPS by
         UpdateChecker (UpdateFailure.INSECURE_URL). -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovelDownloader"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the verified APK in cache/updates/ to the system installer.
             The authority must match UpdateCenter's FileProvider call. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
