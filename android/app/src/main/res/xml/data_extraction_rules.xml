<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (dataExtractionRules). Same reasoning as backup_rules.xml:
     keep the API key and the device-bound SAF grant out of cloud backups.
     Device-to-device transfer keeps them, since the user's own new device
     restores the same credentials without going through the cloud. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/novel_dl_settings.preferences_pb" />
    </cloud-backup>
</data-extraction-rules>
